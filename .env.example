# Database
DATABASE_URL=postgresql://...
# Required by Prisma for migrations (non-pooled connection).
# Dev: same as DATABASE_URL. Prod: Supabase direct URL on port 5432.
DIRECT_URL=postgresql://...

# Auth (pick one)
USE_DEV_AUTH=true
NEXT_PUBLIC_USE_DEV_AUTH=true
DEV_JWT_SECRET=<min-32-chars>
# OR
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Encryption
ENCRYPTION_KEY=<64 hex chars: openssl rand -hex 32>

# Payments
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_MONTHLY=
LEMONSQUEEZY_VARIANT_YEARLY=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Email & Cron
RESEND_API_KEY=
CRON_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3111

# Photo storage
PHOTO_STORAGE=local                        # 'local' (dev) or 'supabase' (prod)

# Supabase Storage (prod only — required when PHOTO_STORAGE=supabase)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=hearth-photos

# Web Push (VAPID) — for gentle reminders
# Generate with: docker compose exec app npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@hearth.app
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Resend identities — env-driven so we don't hardcode addresses
RESEND_FROM_LETTERS=Hearth <letters@hearth.app>
RESEND_FROM_SYSTEM=Hearth <hello@hearth.app>
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Used for stranger-note moderation (omni-moderation-latest). Optional in dev — if unset, moderation is skipped.
OPENAI_API_KEY=

# Error monitoring — Sentry (optional; SDK stays inert if DSN is unset)
NEXT_PUBLIC_SENTRY_DSN=                     # public DSN, used client + server
SENTRY_DSN=                                 # optional server-only override; falls back to NEXT_PUBLIC_SENTRY_DSN
NEXT_PUBLIC_SENTRY_ENV=                     # e.g. production | preview | development (defaults to NODE_ENV)
# Source-map upload at build time (CI/Vercel only — leave blank locally):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Product/traffic analytics — Vercel (zero config; active only on Vercel hosting)
# @vercel/analytics + @vercel/speed-insights are wired in src/app/layout.tsx.
# Enable "Analytics" and "Speed Insights" in the Vercel project dashboard; no keys needed.
