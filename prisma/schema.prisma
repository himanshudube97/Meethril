generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String         @id @default(cuid())
  email     String         @unique
  name      String?
  avatar    String?
  provider  String         @default("dev") // "dev" | "google"
  profile   Json? // Stores answers to thoughtful "about me" questions
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  entries           JournalEntry[]
  scrapbooks        Scrapbook[]
  encryptedBlobs    EncryptedBlob[]
  orphanedBlobs     OrphanedBlob[]
  pushSubscriptions PushSubscription[]
  letters           Letter[]

  // A Small Light counters & rate limit (anonymous notes to strangers)
  strangerNotesSent       Int       @default(0)
  strangerNotesReceived   Int       @default(0)
  lastStrangerNoteSentAt  DateTime?

  sentStrangerNotes       StrangerNote[] @relation("SentStrangerNotes")
  receivedStrangerNotes   StrangerNote[] @relation("ReceivedStrangerNotes")

  // Stranger Notes v2 — E2EE keypair + suspension flag.
  strangerPublicKey             String?
  strangerWrappedPrivateKey     String?
  strangerNotesSendingSuspended Boolean @default(false)

  // Relations for the new tables
  sentStrangerThreads      StrangerThread[]  @relation("SentStrangerThreads")
  receivedStrangerThreads  StrangerThread[]  @relation("ReceivedStrangerThreads")
  strangerMessagesSent     StrangerMessage[] @relation("StrangerMessagesSent")
  strangerWaves            StrangerWave[]    @relation("StrangerWaves")
  strangerBlocksInitiated  StrangerBlock[]   @relation("StrangerBlocksInitiated")
  strangerBlocksReceived   StrangerBlock[]   @relation("StrangerBlocksReceived")

  // Lemon Squeezy subscription fields (DEPRECATED — kept until a follow-up
  // cleanup migration once Dodo is verified in production. Do not write these.)
  lemonSqueezyCustomerId String?   @unique
  subscriptionId         String?   @unique // legacy: stored LS sub IDs
  variantId              String? // legacy: stored LS variant IDs

  // Provider-agnostic subscription state. Reused across Lemon Squeezy → Dodo:
  //  - subscriptionStatus now holds Dodo status strings:
  //    "active" | "on_hold" | "cancelled" | "expired" | "pending"
  //  - currentPeriodEnd now holds Dodo's `next_billing_date` (the forward
  //    billing date). It is BOTH the access-expiry reference AND the source of
  //    the monthly quota anchor day. Grace/leeway is applied in isPaidUser(),
  //    never baked into this stored value.
  subscriptionStatus     String?
  currentPeriodEnd       DateTime?

  // Dodo Payments subscription fields
  dodoCustomerId     String? @unique // Dodo customer ID
  dodoSubscriptionId String? @unique // Dodo subscription ID
  dodoProductId      String? // Dodo product ID — identifies monthly vs yearly plan

  // E2EE fields
  e2eeEnabled                Boolean   @default(false)
  encryptedMasterKey         String? // Master key encrypted with daily key
  masterKeyIV                String? // IV for master key encryption
  masterKeySalt              String? // Salt for PBKDF2 derivation
  recoveryKeyHash            String? // Hash to verify recovery key
  encryptedMasterKeyRecovery String? // Master key encrypted with recovery key
  recoveryKeyIV              String? // IV for recovery encryption
  e2eeSetupAt                DateTime?

  @@map("users")
}

/// Webhook idempotency ledger. Dodo (Standard Webhooks) may retry up to 8× and
/// deliver out of order, so every incoming webhook is recorded by its unique
/// `webhook-id` header before we mutate subscription state. A duplicate insert
/// fails the unique PK and the handler short-circuits with a 200.
model ProcessedWebhook {
  id          String   @id // the `webhook-id` header value
  eventType   String? // e.g. "subscription.renewed" — for debugging only
  processedAt DateTime @default(now())

  @@map("processed_webhooks")
}

model JournalEntry {
  id          String    @id @default(cuid())
  text        String
  textPreview String? // First ~150 chars for list views, avoids sending full text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  song        String?
  entryType   String    @default("normal") // normal, letter, unsent_letter, ephemeral
  expiresAt   DateTime?
  tags        String[]  @default([])
  // Per-entry display style (font / ink color / effect). Plain JSON, non-sensitive.
  // null = all defaults (Caveat / theme text / no effect).
  style       Json?
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // E2EE fields — all entries are E2EE; per-field IV map stored here
  e2eeIVs        Json?   // per-field IVs map: { text, textPreview, tags, song, ... }

  // Multi-spread page layout fields
  spreads    Int     @default(1) // Number of spreads (1-3)
  isArchived Boolean @default(false) // Soft delete flag for two-step deletion

  doodles      Doodle[]
  photos       EntryPhoto[]

  // Indexes for scalable queries
  @@index([userId, createdAt(sort: Desc)]) // Timeline queries
  @@index([userId, isArchived]) // For archive queries
  @@map("journal_entries")
}

model OrphanedBlob {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  handle    String    // storage handle (blob id for local, "{userId}/{uuid}.bin" for supabase)
  reason    String    // "backfill_failed", "entry_delete", etc.
  createdAt DateTime  @default(now())
  sweptAt   DateTime?

  @@index([sweptAt])
  @@map("orphaned_blobs")
}


model Letter {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Letter classification per target architecture
  letterType String // "self" | "friend" | "received-friend"

  // Owner's encrypted content (mirrored from JournalEntry.text in Phase 2)
  contentCiphertext String? @db.Text
  contentIVs        Json?
  title             String?
  titleIV           String?

  // Plaintext metadata
  recipientEmail String?
  recipientName  String?
  senderName     String?
  letterLocation String?
  scheduledFor   DateTime?

  // Provenance
  originalSenderId String?
  originalLetterId String?

  // Status snapshot at backfill time. NOT kept in sync by Phase 2 mutations;
  // dual-read joins fresh state from JournalEntry. Phase 3+ migrates to authoritative.
  isSealed         Boolean   @default(true)
  isDelivered      Boolean   @default(false)
  deliveredAt      DateTime?
  isViewed         Boolean   @default(false)
  letterPeekedAt   DateTime?
  isArchived       Boolean   @default(false)
  isReceivedLetter Boolean   @default(false)

  // Phase 4+ fields (LetterDelivery lifecycle mirror)
  firstReadAt        DateTime?
  savedByRecipientAt DateTime?
  bouncedAt          DateTime?
  bouncedReason      String?

  // Phase 4.1: when a recipient hits "Keep forever," the photos from the
  // LetterDeliveryAsset rows get re-encrypted under their master key and
  // uploaded to their photo storage. The resulting refs land here as a
  // JSON array. Null for non-received letters and for received-friend
  // letters with no photos. Drops in Phase 7 cleanup if we ever
  // normalize this.
  keptPhotoRefs Json?

  // Draft autosave fields. Populated while isSealed=false (compose in
  // progress). Encrypted under the owner's master key so they can resume on
  // any device. On seal, the client re-encrypts the body into the final
  // payload (contentCiphertext for self-letters, LetterDelivery
  // transientCiphertext for friend letters) and the seal endpoint nulls
  // these draft fields. Letters live ONLY in this table now; journal_entries
  // is journal-only.
  draftText        String? @db.Text
  draftTextIV      String?
  draftTextPreview String? @db.Text
  draftSong        String?
  draftSongIV      String?
  draftPhotos      Json?
  draftDoodles     Json?
  draftStyle       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  delivery LetterDelivery?

  @@index([userId, letterType, isArchived])
  @@index([scheduledFor, deliveredAt])
  @@map("letters")
}

model LetterDelivery {
  id       String @id @default(cuid())
  letterId String @unique
  letter   Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)

  // Friend letters: AES-256-GCM ciphertext of body_json. Encrypted with
  // letterKey = Argon2id(normalize(answer), salt). Neither the answer nor
  // letterKey ever reach the server.
  transientCiphertext String @db.Text
  transientIV         String

  // Argon2id salt, 16 random bytes base64. Not secret.
  salt String

  // Plaintext: shown to the recipient on the unlock page so they know what
  // answer to type. Visible to anyone with DB access — metadata leak by
  // design (the magic-link recipient has no account, so we have no
  // pre-shared key to encrypt this under).
  question String @db.Text

  // Public token in the URL path. No fragment.
  publicToken String @unique

  resendEmailId String?

  firstReadAt        DateTime?
  transientExpiresAt DateTime?

  createdAt DateTime @default(now())

  assets LetterDeliveryAsset[]

  @@index([transientExpiresAt])
  @@map("letter_deliveries")
}

model LetterDeliveryAsset {
  id         String         @id @default(cuid())
  deliveryId String
  delivery   LetterDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  // letterKey-encrypted asset bytes (base64). Recipient derives letterKey
  // from their typed answer + LetterDelivery.salt and decrypts to recover
  // the original photo bytes.
  ciphertext String @db.Text
  iv         String

  // Asset kind. v1 stores 'photo' here. Doodles inline in the transient
  // ciphertext for size, so 'doodle' is reserved for future per-stroke
  // separation if a doodle ever grows large enough to warrant it.
  type String // 'photo' | 'doodle'

  // Layout metadata — plaintext on the server because it's not sensitive
  // (position numbers, not content). Recipient renders based on these.
  position Int @default(0)
  spread   Int @default(1)
  rotation Int @default(0)

  // Display order within a spread. Smaller first.
  ordinal Int @default(0)

  createdAt DateTime @default(now())

  @@index([deliveryId])
  @@map("letter_delivery_assets")
}

model Doodle {
  id              String       @id @default(cuid())
  journalEntryId  String
  journalEntry    JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  strokes         Json // Array of stroke data
  positionInEntry Int          @default(0)
  spread          Int          @default(1) // Which spread this doodle belongs to (1-3)
  createdAt       DateTime     @default(now())

  @@unique([journalEntryId, spread]) // One doodle per spread
  @@map("doodles")
}

model EntryPhoto {
  id        String   @id @default(cuid())
  entryId   String
  spread    Int // Which spread (1, 2, or 3)
  position  Int // 1 or 2 (left or right photo in the polaroid layout)
  url            String?  // Legacy data URL, or "/api/photos/{handle}" for adapter-stored plaintext blobs. Null when E2EE photo (use encryptedRef instead).
  rotation       Int      @default(0) // Tilt angle for polaroid effect (-15 to 15)
  encryptedRef   String?  // ciphertext of {handle, iv} — set when parent entry is E2EE
  encryptedRefIV String?  // IV for encryptedRef
  createdAt      DateTime @default(now())

  entry JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, spread, position]) // One photo per position per spread
  @@map("entry_photos")
}

model BookQuote {
  id        String   @id @default(cuid())
  quoteText String
  bookTitle String
  author    String?
  mood      Int?
  createdAt DateTime @default(now())

  @@map("book_quotes")
}

model Whisper {
  id       String @id @default(cuid())
  text     String
  category String @default("generic") // generic, mood-specific, pattern-based

  @@map("whispers")
}

model Scrapbook {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String?  // E2EE ciphertext (client-encrypted under master key)
  items          String   @db.Text // E2EE ciphertext JSON blob (ScrapbookItem[])
  e2eeIVs        Json?    // per-field IVs map: { title?, items }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, updatedAt(sort: Desc)])
  @@map("scrapbooks")
}

model EncryptedBlob {
  id         String   @id @default(cuid())
  userId     String
  ciphertext String   @db.Text
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PushSubscription {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint            String    @unique
  p256dh              String
  auth                String
  userAgent           String?
  tz                  String    @default("UTC")
  createdAt           DateTime  @default(now())
  lastFiredAt         DateTime?
  consecutiveIgnored  Int       @default(0)
  pausedAt            DateTime?

  @@index([userId])
  @@index([pausedAt, lastFiredAt])
  @@map("push_subscriptions")
}

model StrangerNote {
  id          String   @id @default(cuid())

  senderId    String
  sender      User     @relation("SentStrangerNotes", fields: [senderId], references: [id], onDelete: Cascade)

  recipientId String?
  recipient   User?    @relation("ReceivedStrangerNotes", fields: [recipientId], references: [id], onDelete: Cascade)

  // AES-256-GCM ciphertext (iv:authTag:encryptedData hex), see src/lib/encryption.ts
  content     String   @db.Text

  // queued | delivered | replied
  // After matchedAt+24h or burn, the row is hard-deleted by cron / API.
  status      String   @default("queued")

  createdAt   DateTime  @default(now())
  matchedAt   DateTime?
  readAt      DateTime?

  reply       StrangerReply?

  @@index([recipientId, status])
  @@index([status, matchedAt])
  @@map("stranger_notes")
}

model StrangerReply {
  id          String   @id @default(cuid())

  noteId      String       @unique
  note        StrangerNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  // AES-256-GCM ciphertext; max 20 words enforced before encryption (src/lib/stranger-notes.ts)
  content     String   @db.Text

  createdAt   DateTime  @default(now())
  readAt      DateTime?

  @@index([createdAt])
  @@map("stranger_replies")
}

model StrangerThread {
  id              String   @id @default(cuid())

  senderId        String
  sender          User     @relation("SentStrangerThreads", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId     String?
  recipient       User?    @relation("ReceivedStrangerThreads", fields: [recipientId], references: [id], onDelete: Cascade)

  // unmatched | active | pen_pal | closed_unwaved
  status          String   @default("unmatched")

  senderDisplayName    String
  recipientDisplayName String?

  createdAt       DateTime  @default(now())
  matchedAt       DateTime?
  lastActivityAt  DateTime  @default(now())
  closedAt        DateTime?

  senderWaveOfferedAt    DateTime?
  recipientWaveOfferedAt DateTime?

  pendingKeyExchange     Boolean  @default(false)
  wrappedKeyForSender    String?
  wrappedKeyForRecipient String?

  senderDismissedAt      DateTime?
  recipientDismissedAt   DateTime?

  senderLastViewedAt     DateTime?
  recipientLastViewedAt  DateTime?

  messages       StrangerMessage[]
  waves          StrangerWave[]

  @@index([senderId, status])
  @@index([recipientId, status])
  @@index([status, lastActivityAt])
  @@map("stranger_threads")
}

model StrangerMessage {
  id           String   @id @default(cuid())

  threadId     String
  thread       StrangerThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  senderId     String
  sender       User     @relation("StrangerMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  content        String   @db.Text
  encryptionTier String   @default("server")

  countryCode  String?
  stateName    String?

  createdAt    DateTime  @default(now())

  @@index([threadId, createdAt])
  @@map("stranger_messages")
}

model StrangerWave {
  id           String   @id @default(cuid())

  threadId     String
  thread       StrangerThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  userId       String
  user         User     @relation("StrangerWaves", fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime  @default(now())

  @@unique([threadId, userId])
  @@map("stranger_waves")
}

model StrangerBlock {
  id           String   @id @default(cuid())

  blockerId    String
  blocker      User     @relation("StrangerBlocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)

  blockedId    String
  blocked      User     @relation("StrangerBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt    DateTime  @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("stranger_blocks")
}
