generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String         @id @default(cuid())
  email     String         @unique
  name      String?
  avatar    String?
  provider  String         @default("dev") // "dev" | "google"
  profile   Json? // Stores answers to thoughtful "about me" questions
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  entries           JournalEntry[]
  scrapbooks        Scrapbook[]
  encryptedBlobs    EncryptedBlob[]
  orphanedBlobs     OrphanedBlob[]
  pushSubscriptions PushSubscription[]
  letters           Letter[]

  // A Small Light counters & rate limit (anonymous notes to strangers)
  strangerNotesSent       Int       @default(0)
  strangerNotesReceived   Int       @default(0)
  lastStrangerNoteSentAt  DateTime?

  sentStrangerNotes       StrangerNote[] @relation("SentStrangerNotes")
  receivedStrangerNotes   StrangerNote[] @relation("ReceivedStrangerNotes")

  // Lemon Squeezy subscription fields
  lemonSqueezyCustomerId String?   @unique
  subscriptionId         String?   @unique
  subscriptionStatus     String? // "active", "cancelled", "past_due", "on_trial", "paused"
  variantId              String? // which variant/plan they subscribed to
  currentPeriodEnd       DateTime? // when current billing period ends (renews_at)

  // E2EE fields
  e2eeEnabled                Boolean   @default(false)
  encryptedMasterKey         String? // Master key encrypted with daily key
  masterKeyIV                String? // IV for master key encryption
  masterKeySalt              String? // Salt for PBKDF2 derivation
  recoveryKeyHash            String? // Hash to verify recovery key
  encryptedMasterKeyRecovery String? // Master key encrypted with recovery key
  recoveryKeyIV              String? // IV for recovery encryption
  e2eeSetupAt                DateTime?

  @@map("users")
}

model JournalEntry {
  id          String    @id @default(cuid())
  text        String
  textPreview String? // First ~150 chars for list views, avoids sending full text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  song        String?
  entryType   String    @default("normal") // normal, letter, unsent_letter, ephemeral
  expiresAt   DateTime?
  tags        String[]  @default([])
  // Per-entry display style (font / ink color / effect). Plain JSON, non-sensitive.
  // null = all defaults (Caveat / theme text / no effect).
  style       Json?
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // E2EE fields — all entries are E2EE; per-field IV map stored here
  e2eeIVs        Json?   // per-field IVs map: { text, textPreview, tags, song, ... }

  // Multi-spread page layout fields
  spreads    Int     @default(1) // Number of spreads (1-3)
  isArchived Boolean @default(false) // Soft delete flag for two-step deletion

  doodles      Doodle[]
  photos       EntryPhoto[]

  // Indexes for scalable queries
  @@index([userId, createdAt(sort: Desc)]) // Timeline queries
  @@index([userId, isArchived]) // For archive queries
  @@map("journal_entries")
}

model OrphanedBlob {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  handle    String    // storage handle (blob id for local, "{userId}/{uuid}.bin" for supabase)
  reason    String    // "backfill_failed", "entry_delete", etc.
  createdAt DateTime  @default(now())
  sweptAt   DateTime?

  @@index([sweptAt])
  @@map("orphaned_blobs")
}


model Letter {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Letter classification per target architecture
  letterType String // "self" | "friend" | "received-friend"

  // Owner's encrypted content (mirrored from JournalEntry.text in Phase 2)
  contentCiphertext String? @db.Text
  contentIVs        Json?
  title             String?
  titleIV           String?

  // Plaintext metadata
  recipientEmail String?
  recipientName  String?
  senderName     String?
  letterLocation String?
  scheduledFor   DateTime?

  // Provenance
  originalSenderId String?
  originalLetterId String?

  // Status snapshot at backfill time. NOT kept in sync by Phase 2 mutations;
  // dual-read joins fresh state from JournalEntry. Phase 3+ migrates to authoritative.
  isSealed         Boolean   @default(true)
  isDelivered      Boolean   @default(false)
  deliveredAt      DateTime?
  isViewed         Boolean   @default(false)
  letterPeekedAt   DateTime?
  isArchived       Boolean   @default(false)
  isReceivedLetter Boolean   @default(false)

  // Phase 4+ fields (LetterDelivery lifecycle mirror)
  firstReadAt        DateTime?
  savedByRecipientAt DateTime?
  bouncedAt          DateTime?
  bouncedReason      String?

  // Phase 4.1: when a recipient hits "Keep forever," the photos from the
  // LetterDeliveryAsset rows get re-encrypted under their master key and
  // uploaded to their photo storage. The resulting refs land here as a
  // JSON array. Null for non-received letters and for received-friend
  // letters with no photos. Drops in Phase 7 cleanup if we ever
  // normalize this.
  keptPhotoRefs Json?

  // Draft autosave fields. Populated while isSealed=false (compose in
  // progress). Encrypted under the owner's master key so they can resume on
  // any device. On seal, the client re-encrypts the body into the final
  // payload (contentCiphertext for self-letters, LetterDelivery
  // transientCiphertext for friend letters) and the seal endpoint nulls
  // these draft fields. Letters live ONLY in this table now; journal_entries
  // is journal-only.
  draftText        String? @db.Text
  draftTextIV      String?
  draftTextPreview String? @db.Text
  draftSong        String?
  draftSongIV      String?
  draftPhotos      Json?
  draftDoodles     Json?
  draftStyle       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  delivery LetterDelivery?

  @@index([userId, letterType, isArchived])
  @@index([scheduledFor, deliveredAt])
  @@map("letters")
}

model LetterDelivery {
  id       String @id @default(cuid())
  letterId String @unique
  letter   Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)

  // Phase 4 (friend letters): the ciphertext that gets delivered.
  // Encrypted with a random per-letter K (NOT the master key).
  transientCiphertext String @db.Text
  transientIV         String

  // K time-locked to letter.scheduledFor via Drand
  tlockedKey String @db.Text

  // Public token used in the URL path. Fragment carries tlockedKey.
  publicToken String @unique

  // Resend tracking
  resendEmailId String?

  // 24h read window tracking
  firstReadAt        DateTime?
  transientExpiresAt DateTime?

  createdAt DateTime @default(now())

  assets LetterDeliveryAsset[]

  @@index([transientExpiresAt])
  @@map("letter_deliveries")
}

model LetterDeliveryAsset {
  id         String         @id @default(cuid())
  deliveryId String
  delivery   LetterDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  // K-encrypted asset bytes (base64). Recipient has K via the URL
  // fragment + tlock; decrypts with K to recover the original photo
  // or doodle bytes.
  ciphertext String @db.Text
  iv         String

  // Asset kind. v1 stores 'photo' here. Doodles inline in the transient
  // ciphertext for size, so 'doodle' is reserved for future per-stroke
  // separation if a doodle ever grows large enough to warrant it.
  type String // 'photo' | 'doodle'

  // Layout metadata — plaintext on the server because it's not sensitive
  // (position numbers, not content). Recipient renders based on these.
  position Int @default(0)
  spread   Int @default(1)
  rotation Int @default(0)

  // Display order within a spread. Smaller first.
  ordinal Int @default(0)

  createdAt DateTime @default(now())

  @@index([deliveryId])
  @@map("letter_delivery_assets")
}

model Doodle {
  id              String       @id @default(cuid())
  journalEntryId  String
  journalEntry    JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  strokes         Json // Array of stroke data
  positionInEntry Int          @default(0)
  spread          Int          @default(1) // Which spread this doodle belongs to (1-3)
  createdAt       DateTime     @default(now())

  @@unique([journalEntryId, spread]) // One doodle per spread
  @@map("doodles")
}

model EntryPhoto {
  id        String   @id @default(cuid())
  entryId   String
  spread    Int // Which spread (1, 2, or 3)
  position  Int // 1 or 2 (left or right photo in the polaroid layout)
  url            String?  // Legacy data URL, or "/api/photos/{handle}" for adapter-stored plaintext blobs. Null when E2EE photo (use encryptedRef instead).
  rotation       Int      @default(0) // Tilt angle for polaroid effect (-15 to 15)
  encryptedRef   String?  // ciphertext of {handle, iv} — set when parent entry is E2EE
  encryptedRefIV String?  // IV for encryptedRef
  createdAt      DateTime @default(now())

  entry JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, spread, position]) // One photo per position per spread
  @@map("entry_photos")
}

model BookQuote {
  id        String   @id @default(cuid())
  quoteText String
  bookTitle String
  author    String?
  mood      Int?
  createdAt DateTime @default(now())

  @@map("book_quotes")
}

model Whisper {
  id       String @id @default(cuid())
  text     String
  category String @default("generic") // generic, mood-specific, pattern-based

  @@map("whispers")
}

model Scrapbook {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String?  // E2EE ciphertext (client-encrypted under master key)
  items          String   @db.Text // E2EE ciphertext JSON blob (ScrapbookItem[])
  e2eeIVs        Json?    // per-field IVs map: { title?, items }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, updatedAt(sort: Desc)])
  @@map("scrapbooks")
}

model EncryptedBlob {
  id         String   @id @default(cuid())
  userId     String
  ciphertext String   @db.Text
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PushSubscription {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint            String    @unique
  p256dh              String
  auth                String
  userAgent           String?
  tz                  String    @default("UTC")
  createdAt           DateTime  @default(now())
  lastFiredAt         DateTime?
  consecutiveIgnored  Int       @default(0)
  pausedAt            DateTime?

  @@index([userId])
  @@index([pausedAt, lastFiredAt])
  @@map("push_subscriptions")
}

model StrangerNote {
  id          String   @id @default(cuid())

  senderId    String
  sender      User     @relation("SentStrangerNotes", fields: [senderId], references: [id], onDelete: Cascade)

  recipientId String?
  recipient   User?    @relation("ReceivedStrangerNotes", fields: [recipientId], references: [id], onDelete: Cascade)

  // AES-256-GCM ciphertext (iv:authTag:encryptedData hex), see src/lib/encryption.ts
  content     String   @db.Text

  // queued | delivered | replied
  // After matchedAt+24h or burn, the row is hard-deleted by cron / API.
  status      String   @default("queued")

  createdAt   DateTime  @default(now())
  matchedAt   DateTime?
  readAt      DateTime?

  reply       StrangerReply?

  @@index([recipientId, status])
  @@index([status, matchedAt])
  @@map("stranger_notes")
}

model StrangerReply {
  id          String   @id @default(cuid())

  noteId      String       @unique
  note        StrangerNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  // AES-256-GCM ciphertext; max 20 words enforced before encryption (src/lib/stranger-notes.ts)
  content     String   @db.Text

  createdAt   DateTime  @default(now())
  readAt      DateTime?

  @@index([createdAt])
  @@map("stranger_replies")
}
